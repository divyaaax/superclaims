# ==========================================
# Claim Processing Pipeline Configuration
# ==========================================

# OpenAI or OpenAI-Compatible API Key (Required for live LLM operations)
OPENAI_API_KEY=your_openai_api_key_here

# Base URL (Optional: defaults to OpenAI public API. Can point to Groq, OpenRouter, Local Ollama, vLLM, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# LLM Model Name (e.g., gpt-4o-mini, gpt-4o, etc.)
LLM_MODEL=gpt-4o-mini

# Model Temperature (0.0 recommended for deterministic classification and extraction)
LLM_TEMPERATURE=0.0

# Mock Mode (Set to true to run offline tests or dry-runs without making external API calls)
USE_MOCK_LLM=false

# PDF Processing & Upload Limits
MAX_FILE_SIZE_MB=25

# Page batch size when classifying large PDFs
BATCH_SIZE=5

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
